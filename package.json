{
  "name": "simple-timeline",
  "version": "0.1.0",
  "private": true,
  "description": "Offline project timeline for Windows",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.domain.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:tz": "node scripts/testing/run-unit-tz.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "electron-vite": "6.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron-builder": "26.18.0",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0"
  }
