{
  "name": "simple-timeline",
  "version": "0.3.0",
  "private": true,
  "description": "Offline project timeline for Windows",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.domain.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:tz": "node scripts/testing/run-unit-tz.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "node --use-env-proxy node_modules/electron/install.js && electron-builder install-app-deps",
    "test:native": "tsc -p tsconfig.native.json && node scripts/testing/run-native.mjs",
    "build": "npm run typecheck && electron-vite build --config electron.vite.config.mts",
    "dev": "electron-vite dev --config electron.vite.config.mts",
    "test:ui": "vitest run --config vitest.ui.config.mts",
    "build:test": "electron-vite build --config electron.vite.test.config.mts",
    "test:e2e": "npm run build:test && playwright test --config playwright.config.mts",
    "verify:app": "node scripts/testing/verify-app.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "dist:win": "npm run build && node scripts/release/build-windows.mjs",
    "dist:win:test-update": "node scripts/release/build-windows.mjs --validation-update",
    "test:packaged": "node scripts/testing/packaged-smoke.mjs && playwright test --config playwright.packaged.config.mts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "electron-vite": "6.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron-builder": "26.18.0",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0"
  },
  "author": "kdydesign"
}
